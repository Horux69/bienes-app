# Producción (Easypanel) — usar Connection Pooler si el VPS no tiene IPv6:
# Supabase → Project Settings → Database → Connect → Session pooler
#
# SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.TU_PROJECT_REF
# SUPABASE_DB_PASSWORD=tu_password
# SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...
# SUPABASE_BUCKET=BIENES
# SUPABASE_BUCKET_PUBLIC=false

SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_PASSWORD=tu_password_aqui
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_tu_clave_aqui
SUPABASE_BUCKET=BIENES
SUPABASE_BUCKET_PUBLIC=false
